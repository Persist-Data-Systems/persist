# Copy to .env and adjust. .env is git-ignored.

DJANGO_SETTINGS_MODULE=persist.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://persist:persist@localhost:5432/persist

# GeoDjango: leave False until you model geometry in the locations app.
# To enable: install system libs (Arch: sudo pacman -S --needed gdal geos proj),
# then set this True. The DB engine switches to PostGIS automatically.
DJANGO_USE_GIS=False
# GDAL_LIBRARY_PATH=/usr/lib/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/libgeos_c.so
